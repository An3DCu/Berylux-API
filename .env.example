# Copy to .env (never committed) and fill in. Docker Compose and ./gradlew bootRun read it.
POSTGRES_DB=berylux
POSTGRES_USER=berylux
# Any long random string; only this machine's PostgreSQL uses it.
POSTGRES_PASSWORD=
# Signs access tokens: at least 32 random bytes in Base64. The API won't start without it.
#   PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   macOS/Linux: openssl rand -base64 32
BERYLUX_TOKEN_SECRET=
